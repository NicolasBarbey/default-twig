{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Search redirections'|trans }}{% endblock %}
{% block body_testid %}search-redirects-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Search redirections'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="search-redirects-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Search redirections'|trans }}</h1>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                {% include '@BackOfficeDefaultTwig/configuration/search_dictionary/_language_filter.html.twig' %}
                {% if is_granted('CREATE', 'admin.configuration') %}
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#search-redirect-import-modal" data-testid="search-redirect-import-button">
                        <i class="bi bi-upload" aria-hidden="true"></i> {{ 'Import'|trans }}
                    </button>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#search-redirect-create-modal" data-testid="search-redirect-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a redirection'|trans }}
                    </button>
                {% endif %}
            </div>
        </div>

        {{ component('BoDataTable', {
            id: 'search-redirects',
            columns: [
                column('term', 'Term'|trans, 'start', 'term'),
                column('target', 'Target'|trans, 'start', wrap: true),
                column_toggle('active', 'Active'|trans, 'toggle_url'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No redirection defined in this language.'|trans,
            sortField: sort_field,
            sortDirection: sort_direction,
            sortKeepParams: { language_id: language_id },
        }) }}

        {% if last_page > 1 %}
            {{ component('BoPagination', {
                route: 'admin.configuration.search_redirects.default',
                currentPage: current_page,
                lastPage: last_page,
                routeParams: { language_id: language_id, order: sort_field, direction: sort_direction },
                ariaLabel: 'Search redirections pagination'|trans,
                testid: 'search-redirects-pagination',
            }) }}
        {% endif %}
    </div>

    {% if is_granted('CREATE', 'admin.configuration') %}
        {% if reopen_create|default(false) %}
            <div hidden data-controller="bo-auto-open-modal" data-bo-auto-open-modal-target-value="#search-redirect-create-modal" data-testid="search-redirect-create-reopen"></div>
        {% endif %}

        {% component 'BoCreateDialog' with {
            id: 'search-redirect-create-modal',
            title: 'New redirection',
            form: create_form,
            formAction: path('admin.configuration.search_redirects.create'),
            submitLabel: 'Create',
            testid: 'search-redirect-create',
            fieldsTemplate: '@BackOfficeDefaultTwig/configuration/search_redirect/_fields.html.twig',
        } %}
        {% endcomponent %}

        {% include '@BackOfficeDefaultTwig/configuration/search_dictionary/_import_modal.html.twig' with {
            language_id: language_id,
            id: 'search-redirect-import-modal',
            action: path('admin.configuration.search_redirects.import'),
            testid: 'search-redirect-import',
            format: 'locale;term;type (product, category, content, folder, brand or url);identifier, or path for url'|trans,
            example: 'en_US;sale;category;12',
        } only %}
    {% endif %}

    {% include '@BackOfficeDefaultTwig/configuration/search_redirect/_delete_modal.html.twig' %}
{% endblock %}
