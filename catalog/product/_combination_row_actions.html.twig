{# The actions of one combination, in their own template so that an override can change them without copying the whole tab.
   Expects: row (row.id, row.label, row.isdefault), product (product.id).
   A copy keeps data-bo-combination-default-target="choice" and data-pse-id on the "Set as default" entry, or it does nothing. #}
{# Fixed-position dropdown, so the scrolling box does not clip it. A lone button: in a .btn-group, the menu would square its end corners. #}
<div class="dropdown d-inline-block" data-controller="bo-overflow-dropdown">
    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon"
            data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"
            title="{{ 'More actions'|trans }}" aria-label="{{ 'Actions of %combination%'|trans({ '%combination%': row.label }) }}"
            data-testid="combinations-actions-{{ row.id }}">
        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end bo-action-row-dropdown" data-testid="combinations-actions-menu-{{ row.id }}">
        <li>
            <button type="button" class="dropdown-item"
                    data-action="bo-combination-default#choose"
                    data-bo-combination-default-target="choice" data-pse-id="{{ row.id }}"
                    {% if row.isdefault %}disabled{% endif %}
                    data-testid="combinations-set-default-{{ row.id }}">
                <i class="bi bi-star me-2" aria-hidden="true"></i>{{ 'Set as default'|trans }}
            </button>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <button type="button" class="dropdown-item"
                    data-bs-toggle="modal" data-bs-target="#pse-assoc-modal"
                    data-pse-id="{{ row.id }}" data-assoc-type="image"
                    data-testid="combinations-assoc-image-{{ row.id }}">
                <i class="bi bi-images me-2" aria-hidden="true"></i>{{ 'Associate images'|trans }}
            </button>
        </li>
        <li>
            <button type="button" class="dropdown-item"
                    data-bs-toggle="modal" data-bs-target="#pse-assoc-modal"
                    data-pse-id="{{ row.id }}" data-assoc-type="document"
                    data-testid="combinations-assoc-document-{{ row.id }}">
                <i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>{{ 'Associate documents'|trans }}
            </button>
        </li>
        <li>
            <button type="button" class="dropdown-item"
                    data-bs-toggle="modal" data-bs-target="#pse-assoc-modal"
                    data-pse-id="{{ row.id }}" data-assoc-type="video"
                    data-testid="combinations-assoc-video-{{ row.id }}">
                <i class="bi bi-film me-2" aria-hidden="true"></i>{{ 'Associate videos'|trans }}
            </button>
        </li>
        <li>
            <button type="button" class="dropdown-item"
                    data-bs-toggle="modal" data-bs-target="#pse-assoc-modal"
                    data-pse-id="{{ row.id }}" data-assoc-type="virtual"
                    data-testid="combinations-assoc-virtual-{{ row.id }}">
                <i class="bi bi-cloud-arrow-down me-2" aria-hidden="true"></i>{{ 'Associate virtual document'|trans }}
            </button>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <button type="button" class="dropdown-item text-danger"
                    data-bs-toggle="modal" data-bs-target="#pse-delete-modal"
                    data-pse-id="{{ row.id }}"
                    data-testid="combinations-delete-{{ row.id }}">
                <i class="bi bi-trash me-2" aria-hidden="true"></i>{{ 'Delete combination'|trans }}
            </button>
        </li>
    </ul>
</div>
